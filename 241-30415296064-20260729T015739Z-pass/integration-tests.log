2026-07-29T01:57:01.5148763Z [36;1m    dur = f'{durations[i-1]:.1f}s' if i <= len(durations) else '?'[0m
2026-07-29T01:57:01.5148979Z [36;1m    print(f'  {name}: {dur}, dns:{hits}h/{misses}m')[0m
2026-07-29T01:57:01.5149089Z [36;1m[0m
2026-07-29T01:57:01.5149234Z [36;1mif len(durations) >= 2:[0m
2026-07-29T01:57:01.5149933Z [36;1m    print(f'  Speedup: {durations[0]/durations[1]:.1f}x' if durations[1] > 0 else '  2nd domain was instant')[0m
2026-07-29T01:57:01.5150071Z [36;1m" || true[0m
