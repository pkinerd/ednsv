2026-07-29T01:57:01.5145961Z [36;1mtext = re.sub(r'\x1b\[[0-9;]*m', '', raw)[0m
2026-07-29T01:57:01.5146071Z [36;1m[0m
2026-07-29T01:57:01.5146299Z [36;1m# Duration is in Spectre table: │ Duration │ 80.7s │[0m
2026-07-29T01:57:01.5146701Z [36;1mdurations = [float(m.group(1)) for m in re.finditer(r'Duration\s*│\s*(\d+\.?\d*)s', text)][0m
2026-07-29T01:57:01.5146814Z [36;1m[0m
2026-07-29T01:57:01.5147123Z [36;1m# Find DNS hit/miss totals per domain block (split on Validating:)[0m
