<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- Microsoft.Extensions.Logging.Console is deliberately absent: it ships in the
       Microsoft.AspNetCore.App shared framework, so the console logger and the
       Logging__Console__FormatterName knob run-web.sh sets are available without it. -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <ProjectReference Include="..\Ednsv.Core\Ednsv.Core.csproj" />
  </ItemGroup>

</Project>
