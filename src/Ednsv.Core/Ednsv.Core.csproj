<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- System.Text.Json is deliberately absent: it ships in the net10.0 shared
       framework. Referencing it explicitly (as this project did on net8.0, to pull a
       newer serializer than that framework carried) now only risks pinning an older
       out-of-band copy than the runtime's own. -->
  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.8.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="10.0.10" />
    <PackageReference Include="StackExchange.Redis" Version="3.0.17" />
  </ItemGroup>


  <!-- Build provenance. SourceRevisionId is the SDK's own hook (it appends to
       AssemblyInformationalVersion); branch and PR have no equivalent, so they ride as
       assembly metadata. All three are supplied by the container build, which has no
       .git to derive them from. -->
  <ItemGroup>
    <AssemblyMetadata Include="SourceBranch" Value="$(SourceBranch)" Condition="'$(SourceBranch)' != ''" />
    <AssemblyMetadata Include="SourcePullRequest" Value="$(SourcePullRequest)" Condition="'$(SourcePullRequest)' != ''" />
  </ItemGroup>

</Project>
