<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DnsClient" Version="1.7.0" />
    <PackageReference Include="Microsoft.Extensions.Caching.Memory" Version="8.0.1" />
    <PackageReference Include="StackExchange.Redis" Version="2.8.16" />
    <PackageReference Include="System.Text.Json" Version="10.0.5" />
  </ItemGroup>


  <!-- Build provenance. SourceRevisionId is the SDK's own hook (it appends to
       AssemblyInformationalVersion); branch and PR have no equivalent, so they ride as
       assembly metadata. All three are supplied by the container build, which has no
       .git to derive them from. -->
  <ItemGroup>
    <AssemblyMetadata Include="SourceBranch" Value="$(SourceBranch)" Condition="'$(SourceBranch)' != ''" />
    <AssemblyMetadata Include="SourcePullRequest" Value="$(SourcePullRequest)" Condition="'$(SourcePullRequest)' != ''" />
  </ItemGroup>

</Project>
