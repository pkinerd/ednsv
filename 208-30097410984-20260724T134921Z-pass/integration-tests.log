2026-07-24T13:45:23.7814622Z [36;1mecho "============================================"[0m
2026-07-24T13:45:23.7814704Z [36;1mpython3 -c "[0m
2026-07-24T13:45:23.7814783Z [36;1mimport re[0m
2026-07-24T13:45:23.7814856Z [36;1m[0m
2026-07-24T13:45:23.7814949Z [36;1m# Strip ANSI escape codes[0m
2026-07-24T13:45:23.7815086Z [36;1mraw = open('test-output/multi-domain.txt').read()[0m
2026-07-24T13:45:23.7815198Z [36;1mtext = re.sub(r'\x1b\[[0-9;]*m', '', raw)[0m
2026-07-24T13:45:23.7815265Z [36;1m[0m
2026-07-24T13:45:23.7815415Z [36;1m# Duration is in Spectre table: │ Duration │ 80.7s │[0m
2026-07-24T13:45:23.7815682Z [36;1mdurations = [float(m.group(1)) for m in re.finditer(r'Duration\s*│\s*(\d+\.?\d*)s', text)][0m
2026-07-24T13:45:23.7815750Z [36;1m[0m
2026-07-24T13:45:23.7815942Z [36;1m# Find DNS hit/miss totals per domain block (split on Validating:)[0m
2026-07-24T13:45:23.7816064Z [36;1mblocks = re.split(r'Validating:', text)[0m
2026-07-24T13:45:23.7816174Z [36;1mdomains = ['google.com', 'gmail.com'][0m
2026-07-24T13:45:23.7816287Z [36;1mfor i, block in enumerate(blocks[1:], 1):[0m
2026-07-24T13:45:23.7816416Z [36;1m    hm = re.findall(r'dns:(\d+)h/(\d+)m', block)[0m
2026-07-24T13:45:23.7816516Z [36;1m    hits = sum(int(h) for h,_ in hm)[0m
2026-07-24T13:45:23.7816622Z [36;1m    misses = sum(int(m) for _,m in hm)[0m
2026-07-24T13:45:23.7816787Z [36;1m    name = domains[i-1] if i <= len(domains) else f'domain #{i}'[0m
2026-07-24T13:45:23.7816958Z [36;1m    dur = f'{durations[i-1]:.1f}s' if i <= len(durations) else '?'[0m
2026-07-24T13:45:23.7817098Z [36;1m    print(f'  {name}: {dur}, dns:{hits}h/{misses}m')[0m
2026-07-24T13:45:23.7817324Z [36;1m[0m
2026-07-24T13:45:23.7817415Z [36;1mif len(durations) >= 2:[0m
2026-07-24T13:45:23.7817713Z [36;1m    print(f'  Speedup: {durations[0]/durations[1]:.1f}x' if durations[1] > 0 else '  2nd domain was instant')[0m
2026-07-24T13:45:23.7817794Z [36;1m" || true[0m
